# Copy to .env. docker-compose reads this file automatically; a local
# virtualenv run picks it up through python-dotenv.

# --- Database ---
# Either DATABASE_URL, or the individual PG* vars below.
# DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding_songs
PGHOST=localhost
PGPORT=5432
PGUSER=wedding
PGPASSWORD=wedding
PGDATABASE=wedding_songs

# --- Event ---
EVENT_SLUG=wedding
EVENT_NAME=Trevor & ___
EVENT_DATE=2026-00-00

# --- Security ---
# Signs the guest cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this invalidates every guest's identity and their vote history.
SECRET_KEY=
# Unlocks /admin (the DJ view). Leave blank to disable that view entirely.
ADMIN_TOKEN=
# 1 behind HTTPS (the VPS), 0 for plain-HTTP local testing.
COOKIE_SECURE=1

# --- Spotify (Client Credentials; see README) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
# 1 searches the bundled demo catalog instead of the live API.
SPOTIFY_OFFLINE=0

# --- Behavior ---
# 1 rejects tracks Spotify flags explicit, without needing a rule per song.
BLOCK_EXPLICIT=0
# Non-empty seeds a fake board on container start. Leave blank for the real event.
SEED_DEMO=
